# Copy this file to .env and replace both placeholder values with unique,
# local-only passwords before starting Docker Compose.
COMPOSE_PROJECT_NAME=smartchain
MYSQL_ROOT_PASSWORD=replace-with-a-unique-root-password
MYSQL_USER=smartchain
MYSQL_PASSWORD=replace-with-a-different-unique-password
MYSQL_DB=smartchain_db

# Override these only if another application is already using the default ports.
SMARTCHAIN_DB_PORT=3306
SMARTCHAIN_API_PORT=8000
SMARTCHAIN_WEB_PORT=3000
