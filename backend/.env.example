# SmartChain Backend Environment Variables
PROJECT_NAME="SmartChain SCM"
API_V1_STR="/api"

# MySQL Configuration (Default for Docker Compose)
MYSQL_USER=smartchain
MYSQL_PASSWORD=replace-with-a-unique-local-password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=smartchain_db

